{
  "name": "scribeaside",
  "displayName": "ScribeAside",
  "description": "A markdown notepad that lives in your VS Code sidebar — muted, hidden, or fully rendered syntax, with workspace, global, and committable team notes.",
  "version": "0.5.1",
  "publisher": "smlfrysamuri",
  "packageManager": "pnpm@10.33.0",
  "license": "GPL-3.0-or-later",
  "icon": "images/icon.png",
  "repository": {
    "url": "https://github.com/smlfrysamuri/ScribeAside",
    "type": "git"
  },
  "homepage": "https://github.com/smlfrysamuri/ScribeAside#readme",
  "bugs": {
    "url": "https://github.com/smlfrysamuri/ScribeAside/issues"
  },
  "keywords": [
    "markdown",
    "notes",
    "notepad",
    "sidebar",
    "editor"
  ],
  "engines": {
    "vscode": "^1.116.0",
    "node": ">=24"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Notebooks"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scribeaside",
          "title": "ScribeAside",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "scribeaside": [
        {
          "type": "webview",
          "id": "scribeaside.notesView",
          "name": "ScribeAside"
        }
      ]
    },
    "commands": [
      {
        "command": "scribeaside.openInEditor",
        "title": "Open in Editor",
        "category": "ScribeAside",
        "icon": "$(notebook)"
      },
      {
        "command": "scribeaside.focusNotes",
        "title": "Focus Notes",
        "category": "ScribeAside"
      },
      {
        "command": "scribeaside.previousPage",
        "title": "Previous Page",
        "category": "ScribeAside",
        "icon": "$(arrow-left)"
      },
      {
        "command": "scribeaside.nextPage",
        "title": "Next Page",
        "category": "ScribeAside",
        "icon": "$(arrow-right)"
      },
      {
        "command": "scribeaside.selectPage",
        "title": "Select Page",
        "category": "ScribeAside",
        "icon": "$(list-flat)"
      },
      {
        "command": "scribeaside.newPage",
        "title": "New Page",
        "category": "ScribeAside",
        "icon": "$(add)"
      },
      {
        "command": "scribeaside.deletePage",
        "title": "Delete Current Page",
        "category": "ScribeAside",
        "icon": "$(trash)"
      },
      {
        "command": "scribeaside.switchToGlobal",
        "title": "Switch to Global Notes",
        "category": "ScribeAside",
        "icon": "$(globe)"
      },
      {
        "command": "scribeaside.switchToWorkspace",
        "title": "Switch to Workspace Notes",
        "category": "ScribeAside",
        "icon": "$(root-folder)"
      },
      {
        "command": "scribeaside.switchToTeam",
        "title": "Switch to Team Notes",
        "category": "ScribeAside",
        "icon": "$(organization)"
      },
      {
        "command": "scribeaside.refreshTeamNotes",
        "title": "Refresh Team Notes",
        "category": "ScribeAside",
        "icon": "$(refresh)"
      },
      {
        "command": "scribeaside.copyPageTo",
        "title": "Copy Page To...",
        "category": "ScribeAside",
        "icon": "$(copy)"
      },
      {
        "command": "scribeaside.enterReaderMode",
        "title": "Show Rendered View",
        "category": "ScribeAside",
        "icon": "$(open-preview)"
      },
      {
        "command": "scribeaside.exitReaderMode",
        "title": "Show Editor View",
        "category": "ScribeAside",
        "icon": "$(edit)"
      },
      {
        "command": "scribeaside.searchPages",
        "title": "Search Across Pages",
        "category": "ScribeAside",
        "icon": "$(search)"
      },
      {
        "command": "scribeaside.find",
        "title": "Find in Note",
        "category": "ScribeAside",
        "icon": "$(search)"
      },
      {
        "command": "scribeaside.exportPage",
        "title": "Export Current Page",
        "category": "ScribeAside",
        "icon": "$(export)"
      },
      {
        "command": "scribeaside.openSettings",
        "title": "Open Settings",
        "category": "ScribeAside",
        "icon": "$(gear)"
      },
      {
        "command": "scribeaside.toggleBold",
        "title": "Toggle Bold",
        "category": "ScribeAside"
      },
      {
        "command": "scribeaside.toggleItalic",
        "title": "Toggle Italic",
        "category": "ScribeAside"
      },
      {
        "command": "scribeaside.toggleStrikethrough",
        "title": "Toggle Strikethrough",
        "category": "ScribeAside"
      },
      {
        "command": "scribeaside.toggleCode",
        "title": "Toggle Inline Code",
        "category": "ScribeAside"
      },
      {
        "command": "scribeaside.toggleHighlight",
        "title": "Toggle Highlight",
        "category": "ScribeAside"
      },
      {
        "command": "scribeaside.toggleHeading",
        "title": "Cycle Heading Level",
        "category": "ScribeAside"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "scribeaside.previousPage",
          "group": "navigation@0",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.nextPage",
          "group": "navigation@1",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.selectPage",
          "group": "navigation@2",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.enterReaderMode",
          "group": "navigation@3",
          "when": "view == scribeaside.notesView && !scribeaside.readerMode"
        },
        {
          "command": "scribeaside.exitReaderMode",
          "group": "navigation@3",
          "when": "view == scribeaside.notesView && scribeaside.readerMode"
        },
        {
          "command": "scribeaside.newPage",
          "group": "navigation@4",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.switchToGlobal",
          "group": "navigation@5",
          "when": "view == scribeaside.notesView && scribeaside.scope == workspace"
        },
        {
          "command": "scribeaside.switchToTeam",
          "group": "navigation@5",
          "when": "view == scribeaside.notesView && scribeaside.scope == global && scribeaside.teamAvailable"
        },
        {
          "command": "scribeaside.switchToWorkspace",
          "group": "navigation@5",
          "when": "view == scribeaside.notesView && scribeaside.scope == global && !scribeaside.teamAvailable"
        },
        {
          "command": "scribeaside.switchToWorkspace",
          "group": "navigation@5",
          "when": "view == scribeaside.notesView && scribeaside.scope == team"
        },
        {
          "command": "scribeaside.refreshTeamNotes",
          "group": "1_scribeaside@0",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.searchPages",
          "group": "2_scribeaside@0",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.find",
          "group": "2_scribeaside@1",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.openInEditor",
          "group": "2_scribeaside@1",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.exportPage",
          "group": "2_scribeaside@2",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.copyPageTo",
          "group": "2_scribeaside@3",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.deletePage",
          "group": "3_scribeaside@1",
          "when": "view == scribeaside.notesView"
        },
        {
          "command": "scribeaside.openSettings",
          "group": "4_scribeaside@1",
          "when": "view == scribeaside.notesView"
        }
      ]
    },
    "keybindings": [
      {
        "command": "scribeaside.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.toggleStrikethrough",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.toggleCode",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.toggleHighlight",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.toggleHeading",
        "key": "ctrl+h",
        "mac": "cmd+h",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.searchPages",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.previousPage",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.nextPage",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.newPage",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "scribeaside.focused"
      },
      {
        "command": "scribeaside.deletePage",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "scribeaside.focused && !scribeaside.inEditor"
      },
      {
        "command": "scribeaside.enterReaderMode",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "scribeaside.focused && !scribeaside.readerMode"
      },
      {
        "command": "scribeaside.exitReaderMode",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "scribeaside.focused && scribeaside.readerMode"
      },
      {
        "command": "scribeaside.focusNotes",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      }
    ],
    "configuration": {
      "title": "ScribeAside",
      "properties": {
        "scribeaside.fontFamily": {
          "type": "string",
          "default": "inherit",
          "description": "Font family for the editor. \"inherit\" uses the VS Code theme font."
        },
        "scribeaside.lineHeight": {
          "type": "number",
          "default": 1.6,
          "description": "Line height in the editor."
        },
        "scribeaside.lineWrapping": {
          "type": "boolean",
          "default": true,
          "description": "Wrap long lines."
        },
        "scribeaside.folding": {
          "type": "boolean",
          "default": false,
          "description": "Enable section folding for H2, H3 headings and frontmatter."
        },
        "scribeaside.listIndentSize": {
          "type": "number",
          "default": 2,
          "description": "Number of spaces per list indent level."
        },
        "scribeaside.lineNumbers": {
          "type": "boolean",
          "default": false,
          "description": "Show line numbers in the gutter."
        },
        "scribeaside.syntaxMode": {
          "type": "string",
          "enum": [
            "muted",
            "hidden"
          ],
          "enumDescriptions": [
            "Markdown characters stay visible but dimmed.",
            "Markdown characters are hidden, except on lines the cursor or selection touches."
          ],
          "default": "muted",
          "description": "How markdown syntax characters are rendered."
        },
        "scribeaside.teamNotesFolder": {
          "type": "string",
          "default": ".scribeaside",
          "description": "Folder for team notes, relative to the first workspace folder. One markdown file per page, so the notes can be committed to git."
        },
        "scribeaside.teamNotesView": {
          "type": "string",
          "enum": [
            "tree",
            "flat"
          ],
          "enumDescriptions": [
            "Show subfolders in Select Page; open one to see the notes inside it.",
            "List every note, including those in subfolders, in a single list."
          ],
          "default": "tree",
          "description": "How team notes stored in subfolders appear in ScribeAside: Select Page."
        },
        "scribeaside.syncGlobalNotes": {
          "type": "boolean",
          "default": false,
          "description": "Sync global notes across devices via VS Code Settings Sync. Opt-in: synced data cannot be removed from the remote once synced."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "webpack": "webpack --mode development",
    "webpack-dev": "webpack --mode development --watch",
    "compile": "tsc -p ./",
    "lint": "biome check src/",
    "format": "biome check --write src/",
    "watch": "webpack --mode development --watch",
    "pretest": "pnpm compile",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:integration",
    "test:unit": "mocha out/test/unit/**/*.test.js",
    "test:integration": "vscode-test",
    "pretest:e2e": "pnpm webpack",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy": "vsce publish",
    "changeset": "changeset",
    "publish:extension": "pnpm vscode:prepublish && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@bekaert-dev/biome-config": "^0.1.1",
    "@biomejs/biome": "^2.4.12",
    "@changesets/cli": "^2.30.0",
    "@playwright/test": "^1.59.1",
    "@types/jsdom": "^28.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "css-loader": "^7.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.2",
    "mocha": "^11.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^6.0.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.3.0",
    "codemirror": "^6.0.0",
    "markdown-it": "^15.0.0",
    "markdown-it-mark": "^4.0.0"
  }
}
